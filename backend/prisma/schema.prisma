generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  EMPLOYEE
  DIRECTOR
  ACCOUNTS
}

enum VoucherStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

model User {
  id                   String   @id @default(cuid())
  name                 String
  email                String   @unique
  passwordHash         String
  role                 Role
  employeeId           String?  @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  employeeVouchers     Voucher[] @relation("EmployeeVouchers")
  directorVouchers     Voucher[] @relation("DirectorVouchers")
}

model Voucher {
  id                    String        @id @default(cuid())
  voucherNumber         String        @unique
  voucherDate           DateTime
  expenseDate           DateTime
  department            String
  expenseTitle          String
  expenseCategory       String
  expenseDescription    String?
  amount                Decimal       @db.Decimal(12, 2)
  status                VoucherStatus @default(DRAFT)
  employeeId            String
  employeeSignaturePath String?
  directorId            String?
  directorSignaturePath String?
  approvalDate          DateTime?
  rejectionReason       String?
  submittedAt           DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  employee User @relation("EmployeeVouchers", fields: [employeeId], references: [id])
  director User? @relation("DirectorVouchers", fields: [directorId], references: [id])

  @@index([employeeId])
  @@index([directorId])
  @@index([status])
  @@index([department])
  @@index([expenseCategory])
  @@index([expenseDate])
  @@index([createdAt])
}